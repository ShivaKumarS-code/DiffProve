# DiffProve dashboard environment (copy to apps/web/.env.local).

# By default the dashboard calls its OWN /api/* paths and this Next.js server
# proxies them to the service (next.config.mjs rewrites). Point the proxy at
# wherever the Fastify service runs; this value stays server-side.
API_PROXY_URL=http://localhost:3000

# Only set NEXT_PUBLIC_API_URL to call the service DIRECTLY from the browser
# (cross-origin; then the service must send CORS headers). Leave unset for
# the recommended same-origin proxy setup above.
# NEXT_PUBLIC_API_URL=https://your-diffprove-service.example
