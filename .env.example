# DiffProve GitHub App server — example environment.
#
# Copy this file to `.env` (git-ignored) and replace every placeholder.
# The server refuses to start with an invalid or incomplete configuration and
# reports every problem at once, naming each variable. Never commit a real
# `.env`, and never paste real secrets into issue trackers or logs.
#
# Setup walkthrough: docs/app-setup.md

# TCP port the Fastify webhook server listens on. Optional; must be an integer
# in [1, 65535]. Default: 3000.
PORT=3000

# Redis connection string used by the BullMQ job orchestrator. Optional; must
# start with `redis://` or `rediss://` (TLS). Default:
# redis://127.0.0.1:6379, which works with `docker compose up -d redis`.
REDIS_URL=redis://127.0.0.1:6379

# Numeric GitHub App ID. Copy it from the App settings page ("About" section):
# https://github.com/settings/apps -> your app -> General. See docs/app-setup.md.
# Digits only; the example value is a placeholder.
GITHUB_APP_ID=123456

# Private key for the GitHub App, created on the App settings page under
# "Private keys" -> "Generate a private key" (downloads a .pem file).
# See docs/app-setup.md.
#
# RECOMMENDED FORM: base64 of the whole .pem file, so the value stays a single
# line that is easy to paste into dashboards and secret stores. Generate it:
#   Linux:   base64 -w0 private-key.pem
#   macOS:   base64 private-key.pem | tr -d '\n'
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("private-key.pem"))
#
# ALTERNATIVE: paste the raw PEM text instead — either multi-line as-is, or on
# one line using literal "\n" escape sequences for the line breaks. Both forms
# are normalized to a real, newline-delimited PEM at startup.
#
# The value below is a placeholder that decodes to a fake key; replace it.
GITHUB_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpSRVBMQUNFLVRISVMtV0lUSC1USEUtQ09OVEVOVFMtT0YtWU9VUi1QUklWQVRFLUtFWS5wZW0KLS0tLS1FTkQgUlNBIFBSSVZBVEUgS0VZLS0tLS0K

# Secret used to verify that webhook deliveries really come from GitHub. You
# choose this value yourself when registering the App (App settings page ->
# Webhook -> "Secret") and must enter the exact same value here. Use a long
# random string, e.g. `openssl rand -hex 32`. See docs/app-setup.md.
# The example value is a placeholder.
GITHUB_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Log verbosity: debug | info | warn | error. Optional; default: info.
# Secrets are never logged.
LOG_LEVEL=info
