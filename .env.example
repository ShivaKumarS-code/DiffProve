# DiffProve GitHub App server — example environment.
#
# Copy this file to `.env` (git-ignored) and replace every placeholder.
# The server refuses to start with an invalid or incomplete configuration and
# reports every problem at once, naming each variable. Never commit a real
# `.env`, and never paste real secrets into issue trackers or logs.
#
# Setup walkthrough: docs/app-setup.md

# TCP port the Fastify webhook server listens on. Optional; must be an integer
# in [1, 65535]. Default: 3000.
PORT=3000

# Redis connection string used by the BullMQ job orchestrator. Optional; must
# start with `redis://` or `rediss://` (TLS). Default:
# redis://127.0.0.1:6379, which works with `docker compose up -d redis`.
# Redis must be reachable for durable PR intake and worker check recovery.
REDIS_URL=redis://127.0.0.1:6379

# Numeric GitHub App ID. Copy it from the App settings page ("About" section):
# https://github.com/settings/apps -> your app -> General. See docs/app-setup.md.
# Digits only; the example value is a placeholder.
GITHUB_APP_ID=123456

# Private key for the GitHub App, created on the App settings page under
# "Private keys" -> "Generate a private key" (downloads a .pem file).
# See docs/app-setup.md.
#
# RECOMMENDED FORM: base64 of the whole .pem file, so the value stays a single
# line that is easy to paste into dashboards and secret stores. Generate it:
#   Linux:   base64 -w0 private-key.pem
#   macOS:   base64 private-key.pem | tr -d '\n'
#   Windows: [Convert]::ToBase64String([IO.File]::ReadAllBytes("private-key.pem"))
#
# ALTERNATIVE: paste the raw PEM text instead — either multi-line as-is, or on
# one line using literal "\n" escape sequences for the line breaks. Both forms
# are normalized to a real, newline-delimited PEM at startup.
#
# The value below is a placeholder that decodes to a fake key; replace it.
GITHUB_PRIVATE_KEY=LS0tLS1CRUdJTiBSU0EgUFJJVkFURSBLRVktLS0tLQpSRVBMQUNFLVRISVMtV0lUSC1USEUtQ09OVEVOVFMtT0YtWU9VUi1QUklWQVRFLUtFWS5wZW0KLS0tLS1FTkQgUlNBIFBSSVZBVEUgS0VZLS0tLS0K

# Secret used to verify that webhook deliveries really come from GitHub. You
# choose this value yourself when registering the App (App settings page ->
# Webhook -> "Secret") and must enter the exact same value here. Use a long
# random string, e.g. `openssl rand -hex 32`. See docs/app-setup.md.
# The example value is a placeholder.
GITHUB_WEBHOOK_SECRET=replace-me-with-a-long-random-string

# Log verbosity: debug | info | warn | error. Optional; default: info.
# Secrets are never logged.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# E2B sandbox (differential runner). Optional as a group.
#
# Without E2B_API_KEY the worker cannot execute Run A / Run B and completes
# the GitHub check as neutral (sandbox unavailable) when delivery succeeds.
# Get a key from the E2B dashboard: https://e2b.dev/dashboard -> "API Keys".
# The example value is a placeholder.
# ---------------------------------------------------------------------------

# E2B API key used to create the two independent ephemeral sandboxes.
# Optional; leave unset to skip sandbox execution.
# E2B_API_KEY=e2b_0000000000000000000000000000000000000000

# Optional custom sandbox template id (a prepared Python/Node image). When
# unset, the E2B SDK's default template is used. The head sandbox is offline
# from boot, so dependencies must be available in the image, local files, or
# a trusted pre-test base cache seed. Cache seeding requires filesystem-only
# E2B snapshots and a compatible template/envd; memory snapshots are not used.
# E2B_TEMPLATE_ID=diffprove-placeholder-template

# Timeout in milliseconds for each targeted test command (Run A and Run B).
# Optional; must be a positive integer. Default: 120000 (2 minutes).
# E2B_TEST_TIMEOUT_MS=120000

# Timeout in milliseconds for dependency setup in each sandbox. Optional;
# must be a positive integer. Default: 240000 (4 minutes).
# E2B_INSTALL_TIMEOUT_MS=240000

# ---------------------------------------------------------------------------
# PostgreSQL persistence (optional).
#
# Stores the `installations`, `repositories`, and `verification_runs` tables
# (docs/architecture.md, "Core Data Model"): the dashboard's repo config,
# verification history, log excerpts, and optional case evidence.
#
# Without DATABASE_URL the server still runs and verifies PRs, but nothing is
# persisted: the API answers 503 and verification runs are not recorded.
#
# Must start with `postgres://` or `postgresql://`. The URL may embed
# credentials, so the value is never echoed in errors or logs. The value below
# is the local default created by `docker compose up -d postgres`.
# ---------------------------------------------------------------------------

# DATABASE_URL=postgresql://diffprove:diffprove@127.0.0.1:5432/diffprove

# ---------------------------------------------------------------------------
# GitHub App OAuth & public origin (optional).
#
# Enables user login on the dashboard via GitHub OAuth. GITHUB_CLIENT_ID,
# GITHUB_CLIENT_SECRET, and SESSION_SECRET are optional as a group: leave all
# three unset to disable OAuth login, or set all three together.
#
# Find Client ID and generate a Client Secret on your GitHub App settings page
# (General -> "OAuth credentials"). Never echo or commit real secrets.
# ---------------------------------------------------------------------------

# GitHub App OAuth Client ID (starts with Iv1. or Ov23li...).
# GITHUB_CLIENT_ID=Iv1.0000000000000000

# GitHub App OAuth Client Secret. Secret — never logged or echoed in errors.
# GITHUB_CLIENT_SECRET=replace-me-with-github-oauth-client-secret

# Secret used to sign dashboard session cookies (minimum 16 characters, e.g.
# `openssl rand -hex 32`). Secret — never logged or echoed in errors.
# SESSION_SECRET=replace-me-with-at-least-16-characters

# Public HTTP(S) origin where the server is reachable (used to construct OAuth
# callback URLs). Optional; must start with `http://` or `https://`. Trailing
# slashes are stripped automatically.
# PUBLIC_URL=http://localhost:3000
