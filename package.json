{
  "name": "diffprove",
  "version": "0.1.0",
  "private": true,
  "description": "Differential PR verifier GitHub App — catches weak or hallucinated tests by running them against base and head commits in isolation",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/web"
  ],
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/server.ts",
    "dev:web": "npm run dev -w apps/web",
    "start": "node dist/server.js",
    "build:web": "npm run build -w apps/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/core": "^7.0.8",
    "bullmq": "^6.7.8",
    "dotenv": "^18.0.10",
    "e2b": "^2.64.0",
    "fastify": "^5.12.8",
    "ioredis": "^6.1.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
